{
	"name": "problem-cloud",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:prod": "vite dev --mode production",
		"build": "bun scripts/vendor-assets.ts --if-missing && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; bun scripts/vendor-assets.ts --if-missing || echo 'vendor-assets skipped; run `bun run vendor:assets` before building'",
		"test": "bun test",
		"test:e2e": "playwright test",
		"vendor:assets": "bun scripts/vendor-assets.ts",
		"vendor:check": "bun scripts/vendor-assets.ts --if-missing",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.0"
	},
	"dependencies": {
		"@any-model/core": "^0.1.1",
		"@any-model/openai-compat": "^0.1.1",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.0",
		"@tanstack/svelte-virtual": "^3.13.35",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	}
}

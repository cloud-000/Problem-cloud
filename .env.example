# Public Supabase browser configuration.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI Coach is off unless this is explicitly true.
AI_COACH_ENABLED=false
# Serves the deterministic mock as a server-owned connection, for development.
AI_COACH_MOCK_ENABLED=false

# First-party hosted Coach. The public Auto offer, OpenRouter fallback list,
# and allowance are hardcoded in src/lib/server/ai/hosted-plan.ts.
# This is the server's key; leave empty to omit the hosted connection.
AI_COACH_HOSTED_API_KEY=

# Users bring their own keys, which stay in their browser and never reach the server.
# BYOK needs no server flag. The hosted key above is the server's, not a user's.

# Server-only Supabase secret key used for server-owned Coach persistence.
# Local development may use SUPABASE_DEV_SECRET_KEY instead.
SUPABASE_SECRET_KEY=

# Google OAuth credentials used by the local Supabase Auth service. Configure
# the same provider in the hosted Supabase dashboard; never commit its secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Development/test-only deterministic mock controls.
AI_COACH_MOCK_CONNECTION_STATE=connected
AI_COACH_MOCK_SCENARIO=success
AI_COACH_MOCK_CHUNK_DELAY_MS=24
